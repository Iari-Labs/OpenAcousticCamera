	)
	(text "T2P: Murata typ. circuit, R19 15k from VC.\nPOE_T2P_N low = Type-2 PSE (25.5 W)."
		(exclude_from_sim no)
		(at 22.86 99.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2c20af64-c13c-4630-9516-c172c0b7f952")
	)
	(text "ISOLATION 2250 VDC"
		(exclude_from_sim no)
		(at 134.62 139.7 90)
		(effects
