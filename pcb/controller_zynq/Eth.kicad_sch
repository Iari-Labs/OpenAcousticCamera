	)
	(text "DP83869 straps are latched when RESET_N is released: PHY_RESET_N has a 1.5k pull-down (R205),\nkeep the PHY in reset until the PL is configured so FPGA pins cannot disturb the RX_D*/RX_CTRL straps.\nPHY_INT_N: enable PULLUP on the FPGA pin. GPIO_0/GPIO_1 -> IEEE1588 TX/RX SFD pulses (reg 1E0h, ENHANCED_MAC_SUPPORT)."
		(exclude_from_sim no)
		(at 152.4 172.72 0)
		(effects
